{
  "version": "4.0.0-beta.0",
  "license": "MIT",
  "name": "mantine-react-table-ng",
  "description": "A fully featured Mantine 9 and React 19 implementation of TanStack React Table V8. Maintained fork of mantine-react-table.",
  "author": "Kevin Vandy",
  "keywords": [
    "react-table",
    "mantine",
    "tanstack table",
    "data table",
    "data grid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CareHarmony/mantine-react-table.git",
    "directory": "packages/mantine-react-table"
  },
  "homepage": "https://github.com/CareHarmony/mantine-react-table#readme",
  "bugs": {
    "url": "https://github.com/CareHarmony/mantine-react-table/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.esm.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./locales/*": "./locales/*",
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "locales",
    "styles.css",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "53 KB"
    },
    {
      "path": "dist/index.esm.mjs",
      "limit": "50 KB"
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "rm -rf dist && rollup -c rollup.config.mjs && size-limit",
    "lib:dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint .",
    "size": "size-limit",
    "storybook": "pnpm storybook:dev",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6007",
    "storybook:serve": "serve storybook-static --listen 6008 --no-clipboard",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compiler": "cross-env MRT_REACT_COMPILER=consumer vitest run",
    "test:compiler:dist": "cross-env MRT_REACT_COMPILER=all MRT_TEST_TARGET=dist vitest run",
    "test:all": "pnpm test && pnpm test:compiler && pnpm test:compiler:dist",
    "prepublishOnly": "pnpm lib:build && pnpm test:all"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@faker-js/faker": "^9.0.3",
    "@mantine/core": "9.8.0",
    "@mantine/dates": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@playwright/test": "^1.50.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@storybook/addon-a11y": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-interactions": "^8.6.17",
    "@storybook/addon-links": "^8.6.17",
    "@storybook/addon-storysource": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/preview-api": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@storybook/testing-library": "^0.2.2",
    "@tabler/icons-react": "3.52.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.7.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.0",
    "eslint-plugin-perfectionist": "^3.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "mantine-contextmenu": "^9.8.1",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "^4.24.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "serve": "^14.2.4",
    "size-limit": "^11.1.6",
    "storybook": "^8.6.17",
    "storybook-dark-mode": "^4.0.2",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@mantine/dates": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "@tabler/icons-react": ">=2.23.0",
    "clsx": ">=2",
    "dayjs": ">=1.11",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "contributors": [
    "CareHarmony"
  ],
  "publishConfig": {
    "access": "public"
  }
}
