{
  "name": "mantine-react-table-docs",
  "private": true,
  "scripts": {
    "build": "pnpm docs:build",
    "dev": "pnpm docs:dev",
    "docs:build": "next build --webpack && pnpm docs:sitemap",
    "docs:dev": "next dev --webpack --port 3001",
    "docs:sitemap": "next-sitemap --config ./next-sitemap.config.cjs",
    "docs:start": "next start --port 4001",
    "lint": "eslint .",
    "start": "pnpm docs:start",
    "sitemap": "pnpm docs:sitemap",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@docsearch/js": "3.9.0",
    "@faker-js/faker": "^9.0.3",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mantine/code-highlight": "9.8.0",
    "@mantine/core": "9.8.0",
    "@mantine/dates": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/modals": "9.8.0",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "16.4.6",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "^5.59.11",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "export-to-csv": "^1.4.0",
    "highlight.js": "11.12.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "mantine-react-table-ng": "workspace:*",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "next-plausible": "^3.12.2",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "raw-loader": "^4.0.2",
    "typescript": "5.6.3"
  }
}
